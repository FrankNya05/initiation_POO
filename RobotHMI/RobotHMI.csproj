<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>RobotHMI</RootNamespace>
        <AssemblyName>RobotHMI</AssemblyName>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <!-- Avalonia UI framework -->
        <PackageReference Include="Avalonia" Version="11.1.0" />
        <PackageReference Include="Avalonia.Desktop" Version="11.1.0" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.0" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.0" />
        <PackageReference Include="Avalonia.Win32" Version="11.1.0" />

        <!--
            JSON parsing — used by TelemetryParser (Phase 2) and CommandSerializer (Phase 3).
            Added now so Phase 2 has no new dependencies to install.
        -->
        <PackageReference Include="System.Text.Json" Version="8.0.0" />

        <!--
            MQTT client — needed by MqttCommClient (real implementation, Phase 2+).
            Stubbed in Phase 1; adding the reference now avoids a build change later.
        -->
        <!-- <PackageReference Include="MQTTnet"                Version="4.3.3" /> -->

        <!-- Diagnostic / compile-time AXAML binding support -->
        <PackageReference Include="Avalonia.Diagnostics" Version="11.1.0" Condition="'$(Configuration)' == 'Debug'" />
    </ItemGroup>

</Project>