<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RobotHMI.App"
             RequestedThemeVariant="Dark">

    <!--
        App.axaml
        ══════════
        Global Avalonia application declaration.
        Theme, global styles, and resources go here.

        Phase 1: dark theme only.
        Future phases may add converters (BooleanToColorConverter, etc.)
        as StaticResource entries in the ResourceDictionary below.
    -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <!--
                Phase 2+: add global converters here.
                Example:
                <local:BooleanToColorConverter x:Key="BoolToColor"/>
            -->
        </ResourceDictionary>
    </Application.Resources>

</Application>
