<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RobotHMI.ViewModels"
             x:Class="RobotHMI.Views.Panels.LogPanelView"
             x:DataType="vm:LogPanelViewModel"
             Background="#0F1923">

    <!--
        MODIFIÉ V2.4 — Onglet LOGS
        Ajouts : filtre texte, export .txt, StatusText
    -->

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- Barre de filtre -->
        <Border Grid.Row="0" Classes="card" Margin="0,0,0,8" Padding="10,8">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <TextBlock Grid.Column="0"
                           Text="Filtre :"
                           Classes="label"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <TextBox Grid.Column="1"
                         Text="{Binding FilterText}"
                         Watermark="Taper pour filtrer… ex: taskLidar, EKF, ATTACK"
                         FontFamily="Consolas, Courier New, monospace"
                         FontSize="12"
                         VerticalAlignment="Center"/>

                <!-- Bouton X pour effacer le filtre -->
                <Button Grid.Column="2"
                        Command="{Binding ClearCommand}"
                        IsVisible="{Binding FilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Background="Transparent"
                        Foreground="#78909C"
                        MinHeight="32"
                        Padding="8,4"
                        Margin="6,0,0,0"
                        Content="✕ Filtre"/>

            </Grid>
        </Border>

        <!-- Liste des logs -->
        <Border Grid.Row="1" Classes="card" Padding="0">
            <Grid RowDefinitions="Auto,*">

                <Border Grid.Row="0"
                        Background="#1C2B3A"
                        BorderBrush="#2A3F55"
                        BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <TextBlock Classes="section-title"
                               Text="MESSAGES LOG"
                               Margin="0"/>
                </Border>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding FilteredEntries}"
                         Background="#0F1923"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontFamily="Consolas, Courier New, monospace"
                                       FontSize="12"
                                       Foreground="#E0E0E0"
                                       Padding="4,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>
        </Border>

        <!-- Barre inférieure : compteur + statut + boutons -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto,Auto,Auto"
              Margin="0,8,0,0">

            <!-- Compteur / résultats filtre -->
            <TextBlock Grid.Column="0"
                       Text="{Binding EntryCountText}"
                       Classes="label"
                       VerticalAlignment="Center"/>

            <!-- Statut (export, erreur…) -->
            <TextBlock Grid.Column="1"
                       Text="{Binding StatusText}"
                       Classes="label"
                       Foreground="#FF9100"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>

            <!-- Export .txt -->
            <Button Grid.Column="2"
                    Command="{Binding ExportCommand}"
                    Background="#1C2B3A"
                    Foreground="#00D4FF"
                    BorderBrush="#2A3F55"
                    BorderThickness="1"
                    MinHeight="40"
                    Padding="14,8"
                    Margin="0,0,8,0"
                    Content="💾  Exporter .txt"/>

            <!-- Effacer -->
            <Button Grid.Column="3"
                    Command="{Binding ClearCommand}"
                    Background="#2A3F55"
                    Foreground="#FF9100"
                    MinHeight="40"
                    Padding="14,8"
                    Content="🗑  Effacer"/>

        </Grid>

    </Grid>

</UserControl>
