<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RobotHMI.ViewModels"
             x:Class="RobotHMI.Views.Panels.StatusBarTopView"
             x:DataType="vm:MainWindowViewModel"
             Background="Transparent">

    <!--
        NOUVEAU V2 — Barre supérieure fixe
        Disposition horizontale ~50px :
        [🤖 Mini-Sumo HMI] | [IP] | [● Connecté] | [⚡ 78% 7.35V] | [État: X] | [Stratégie: X]

        Aucun converter utilisé — couleur conditionnelle via deux TextBlock superposés
        avec IsVisible sur le bool directement.
    -->

    <Grid ColumnDefinitions="Auto,1,16,Auto,16,1,16,Auto,16,1,16,Auto,16,1,16,Auto">

        <!-- Titre -->
        <TextBlock Grid.Column="0"
                   Text="🤖  Mini-Sumo HMI"
                   FontSize="15"
                   FontWeight="Bold"
                   Foreground="#00D4FF"
                   VerticalAlignment="Center"/>

        <!-- Séparateur vertical -->
        <Rectangle Grid.Column="1" Width="1" Height="22" Fill="#2A3F55" VerticalAlignment="Center"/>

        <!-- IP Broker -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="IP:" Foreground="#78909C" FontSize="12" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ConnectionPanel.MqttBrokerIp}"
                       FontFamily="Consolas, Courier New, monospace"
                       FontSize="13"
                       Foreground="#E0E0E0"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <Rectangle Grid.Column="5" Width="1" Height="22" Fill="#2A3F55" VerticalAlignment="Center"/>

        <!-- Indicateur connexion — deux TextBlock superposés, sans converter -->
        <Panel Grid.Column="7" VerticalAlignment="Center">
            <!-- Connecté — vert -->
            <TextBlock Text="● Connecté"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="#00E676"
                       IsVisible="{Binding StatusBar.IsConnected}"/>
            <!-- Déconnecté — gris -->
            <TextBlock Text="○ Déconnecté"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="#78909C"
                       IsVisible="{Binding !StatusBar.IsConnected}"/>
        </Panel>

        <Rectangle Grid.Column="9" Width="1" Height="22" Fill="#2A3F55" VerticalAlignment="Center"/>

        <!-- Batterie -->
        <StackPanel Grid.Column="11" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusBar.BatterySummaryText}"
                       FontFamily="Consolas, Courier New, monospace"
                       FontSize="13"
                       Foreground="#00E676"
                       VerticalAlignment="Center"/>
            <!-- Badge critique — visible seulement si batterie faible -->
            <Border Background="#FF1744" CornerRadius="3" Padding="4,1"
                    IsVisible="{Binding StatusBar.BatteryCritical}"
                    VerticalAlignment="Center">
                <TextBlock Text="⚠" Foreground="White" FontSize="11"/>
            </Border>
        </StackPanel>

        <Rectangle Grid.Column="13" Width="1" Height="22" Fill="#2A3F55" VerticalAlignment="Center"/>

        <!-- État + Stratégie -->
        <StackPanel Grid.Column="15" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">

            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="État:" Foreground="#78909C" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusBar.RobotStatusText}"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="#00D4FF"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Stratégie:" Foreground="#78909C" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusBar.ActiveStrategy, FallbackValue='—'}"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="#FF9100"
                           VerticalAlignment="Center"/>
            </StackPanel>

        </StackPanel>

    </Grid>

</UserControl>
