<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RobotHMI.ViewModels"
             x:Class="RobotHMI.Views.Panels.TelemetryPanelView"
             x:DataType="vm:TelemetryPanelViewModel"
             Background="#0F1923">

    <!-- MODIFIÉ V2 — Onglet TÉLÉMÉTRIE : batterie + ligne + lidar -->
    <!-- NOTE : les indicateurs de capteurs utilisent IsVisible sur deux couches
         (rouge si actif, gris si inactif) — aucun converter requis. -->

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid ColumnDefinitions="*,12,*" Margin="16" VerticalAlignment="Top">

            <!-- ═════════════════════════════════════════════════════════
                 COLONNE GAUCHE : Batterie + Lidar
                 ═════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Column="0" Spacing="12">

                <!-- ─── BATTERIE ─────────────────────────────────────── -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="section-title" Text="BATTERIE"/>
                        <Separator/>

                        <ProgressBar Value="{Binding BatteryPercent}"
                                     Minimum="0" Maximum="100"
                                     Classes.battery-critical="{Binding BatteryCritical}"/>

                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="label" Text="Niveau"/>
                                <TextBlock Classes="value-mono"
                                           Text="{Binding BatteryPercent, StringFormat={}{0} %}"
                                           Foreground="#00E676"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="label" Text="Tension"/>
                                <TextBlock Classes="value-mono"
                                           Text="{Binding BatteryVoltageText}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Badge CRITIQUE — visible uniquement si BatteryCritical = true -->
                        <Border Background="#FF1744" CornerRadius="4" Padding="8,4"
                                IsVisible="{Binding BatteryCritical}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="⚠  CRITIQUE" Foreground="White"
                                       FontWeight="Bold" FontSize="13"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ─── LIDAR ─────────────────────────────────────────── -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="section-title" Text="LIDAR"/>
                        <Separator/>

                        <StackPanel>
                            <TextBlock Classes="label" Text="Distance"/>
                            <TextBlock Classes="value-mono"
                                       Text="{Binding LidarDistText}"
                                       FontSize="28"
                                       Foreground="#00D4FF"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Classes="label" Text="Angle"/>
                            <TextBlock Classes="value-mono"
                                       Text="{Binding LidarAngleText}"
                                       FontSize="20"/>
                        </StackPanel>

                        <TextBlock Text="{Binding LidarStatusText}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#00E676"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ═════════════════════════════════════════════════════════
                 COLONNE DROITE : Capteurs de ligne
                 ═════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Column="2" Spacing="12">

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="section-title" Text="CAPTEURS DE LIGNE"/>
                        <Separator/>

                        <TextBlock Classes="label"
                                   Text="Vue du dessus — Rouge = ligne détectée"
                                   HorizontalAlignment="Center"/>

                        <!--
                            Layout :  [FL]  [FR]  ← avant
                                      ─── 🤖 ───
                                      [BL] [Back]  ← arrière

                            Chaque capteur : deux Ellipse superposées.
                              - Ellipse rouge : visible si capteur actif (IsVisible = bool)
                              - Ellipse grise : visible si capteur inactif (IsVisible = !bool)
                            Aucun converter nécessaire.
                        -->
                        <Grid RowDefinitions="Auto,20,Auto"
                              ColumnDefinitions="*,8,*"
                              Margin="8,4">

                            <!-- ── Avant : FL ── -->
                            <Border Grid.Row="0" Grid.Column="0"
                                    Background="#2A3F55" CornerRadius="6"
                                    Padding="8,10" HorizontalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <Panel Width="18" Height="18" HorizontalAlignment="Center">
                                        <Ellipse Width="18" Height="18" Fill="#FF1744"
                                                 IsVisible="{Binding LineFrontLeft}"/>
                                        <Ellipse Width="18" Height="18" Fill="#455A64"
                                                 IsVisible="{Binding !LineFrontLeft}"/>
                                    </Panel>
                                    <TextBlock Text="FL" Classes="label"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- ── Avant : FR ── -->
                            <Border Grid.Row="0" Grid.Column="2"
                                    Background="#2A3F55" CornerRadius="6"
                                    Padding="8,10" HorizontalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <Panel Width="18" Height="18" HorizontalAlignment="Center">
                                        <Ellipse Width="18" Height="18" Fill="#FF1744"
                                                 IsVisible="{Binding LineFrontRight}"/>
                                        <Ellipse Width="18" Height="18" Fill="#455A64"
                                                 IsVisible="{Binding !LineFrontRight}"/>
                                    </Panel>
                                    <TextBlock Text="FR" Classes="label"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- ── Corps du robot ── -->
                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                    Background="#1C2B3A" BorderBrush="#2A3F55"
                                    BorderThickness="1" CornerRadius="4"
                                    Margin="0,2">
                                <TextBlock Text="🤖  Robot"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Classes="label" FontSize="11"/>
                            </Border>

                            <!-- ── Arrière : BL ── -->
                            <Border Grid.Row="2" Grid.Column="0"
                                    Background="#2A3F55" CornerRadius="6"
                                    Padding="8,10" HorizontalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <Panel Width="18" Height="18" HorizontalAlignment="Center">
                                        <Ellipse Width="18" Height="18" Fill="#FF1744"
                                                 IsVisible="{Binding LineBackLeft}"/>
                                        <Ellipse Width="18" Height="18" Fill="#455A64"
                                                 IsVisible="{Binding !LineBackLeft}"/>
                                    </Panel>
                                    <TextBlock Text="BL" Classes="label"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- ── Arrière : Back ── -->
                            <Border Grid.Row="2" Grid.Column="2"
                                    Background="#2A3F55" CornerRadius="6"
                                    Padding="8,10" HorizontalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <Panel Width="18" Height="18" HorizontalAlignment="Center">
                                        <Ellipse Width="18" Height="18" Fill="#FF1744"
                                                 IsVisible="{Binding LineBack}"/>
                                        <Ellipse Width="18" Height="18" Fill="#455A64"
                                                 IsVisible="{Binding !LineBack}"/>
                                    </Panel>
                                    <TextBlock Text="Back" Classes="label"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                        </Grid>

                        <TextBlock Classes="label" FontSize="11"
                                   Text="Avant = haut du diagramme"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Horodatage -->
                <TextBlock Text="{Binding LastUpdateText, StringFormat='Dernière trame : {0}'}"
                           Classes="label" HorizontalAlignment="Center"/>

            </StackPanel>

        </Grid>
    </ScrollViewer>

</UserControl>
