<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RobotHMI.ViewModels"
             x:Class="RobotHMI.Views.Panels.ControlPanelView"
             x:DataType="vm:ControlPanelViewModel">

    <!--
        ControlPanelView
        ════════════════
        Sends motor commands to the robot.
        All state and commands come from ControlPanelViewModel — zero logic here.

        Layout:
          1. "CONTROL" header
          2. Direction pad — a 3×3 grid with buttons in the cardinal positions
          3. Speed slider  — 0 to 255, labelled
          4. Last command  — one-line feedback
          5. Last ACK      — one-line acknowledgement feedback

        Touch-friendly sizing:
          - Direction buttons: 64×64 px minimum
          - All controls disabled (IsEnabled=false) when not connected
          - IsEnabled bound to IsConnected on the ViewModel
    -->

    <Border Background="#1E1E2E"
            CornerRadius="8"
            Padding="16">

        <StackPanel Spacing="16">

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- Header                                                       -->
            <!-- ═══════════════════════════════════════════════════════════ -->

            <TextBlock Text="CONTROL"
                       Foreground="#89B4FA"
                       FontSize="13"
                       FontWeight="Bold"
                       LetterSpacing="2"/>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- Direction pad                                                -->
            <!--                                                              -->
            <!--   [ empty ] [ ↑ Fwd  ] [ empty ]                           -->
            <!--   [ ← Left] [ ■ Stop ] [ Right →]                          -->
            <!--   [ empty ] [ ↓ Back ] [ empty ]                           -->
            <!--                                                              -->
            <!-- Grid cells are 64×64, columns and rows each 64 + 8 gap.    -->
            <!-- ═══════════════════════════════════════════════════════════ -->

            <Grid RowDefinitions="64,8,64,8,64"
                  ColumnDefinitions="64,8,64,8,64"
                  IsEnabled="{Binding IsConnected}"
                  HorizontalAlignment="Left">

                <!-- Forward — top centre (row 0, col 2) -->
                <Button Grid.Row="0" Grid.Column="2"
                        Command="{Binding ForwardCommand}"
                        Width="64" Height="64"
                        FontSize="22"
                        Content="↑"
                        Background="#313244"
                        Foreground="#CDD6F4"
                        CornerRadius="8"
                        ToolTip.Tip="Forward"/>

                <!-- Left — middle left (row 2, col 0) -->
                <Button Grid.Row="2" Grid.Column="0"
                        Command="{Binding LeftCommand}"
                        Width="64" Height="64"
                        FontSize="22"
                        Content="←"
                        Background="#313244"
                        Foreground="#CDD6F4"
                        CornerRadius="8"
                        ToolTip.Tip="Turn Left"/>

                <!-- Stop — middle centre (row 2, col 2) -->
                <Button Grid.Row="2" Grid.Column="2"
                        Command="{Binding StopCommand}"
                        Width="64" Height="64"
                        FontSize="18"
                        Content="■"
                        Background="#F38BA8"
                        Foreground="#1E1E2E"
                        FontWeight="Bold"
                        CornerRadius="8"
                        ToolTip.Tip="Stop"/>

                <!-- Right — middle right (row 2, col 4) -->
                <Button Grid.Row="2" Grid.Column="4"
                        Command="{Binding RightCommand}"
                        Width="64" Height="64"
                        FontSize="22"
                        Content="→"
                        Background="#313244"
                        Foreground="#CDD6F4"
                        CornerRadius="8"
                        ToolTip.Tip="Turn Right"/>

                <!-- Backward — bottom centre (row 4, col 2) -->
                <Button Grid.Row="4" Grid.Column="2"
                        Command="{Binding BackwardCommand}"
                        Width="64" Height="64"
                        FontSize="22"
                        Content="↓"
                        Background="#313244"
                        Foreground="#CDD6F4"
                        CornerRadius="8"
                        ToolTip.Tip="Backward"/>

            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- Speed slider                                                 -->
            <!-- ═══════════════════════════════════════════════════════════ -->

            <StackPanel Spacing="6" IsEnabled="{Binding IsConnected}">

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Speed"
                               Foreground="#6C7086"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Width="46"/>
                    <TextBlock Text="{Binding Speed}"
                               Foreground="#CBA6F7"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Width="34"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="/ 255"
                               Foreground="#45475A"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Slider Minimum="0"
                        Maximum="255"
                        Value="{Binding Speed}"
                        Width="204"
                        HorizontalAlignment="Left"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"/>

            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- Feedback — last command sent                                 -->
            <!-- ═══════════════════════════════════════════════════════════ -->

            <StackPanel Spacing="2">

                <TextBlock Text="{Binding LastCommandText}"
                           Foreground="#A6E3A1"
                           FontSize="12"/>

                <TextBlock Text="{Binding LastAckText}"
                           Foreground="#89DCEB"
                           FontSize="12"/>

            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- Disconnected hint — visible only when not connected          -->
            <!-- ═══════════════════════════════════════════════════════════ -->

            <TextBlock Text="Connect first to enable controls."
                       Foreground="#45475A"
                       FontSize="11"
                       FontStyle="Italic"
                       IsVisible="{Binding !IsConnected}"/>

        </StackPanel>
    </Border>

</UserControl>
