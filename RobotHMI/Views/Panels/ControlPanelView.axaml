<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RobotHMI.ViewModels"
             x:Class="RobotHMI.Views.Panels.ControlPanelView"
             x:DataType="vm:ControlPanelViewModel"
             Background="#0F1923">

    <!-- MODIFIÉ V2 — Onglet CONTRÔLE : Match + Stratégie -->
    <!-- Aucune classe conditionnelle complexe — surbrillance stratégie via
         deux Border superposés avec IsVisible sur le bool. -->

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16" Spacing="16">

            <!-- ═══════════════════════════════════════════════════════════
                 SECTION MATCH
                 ═══════════════════════════════════════════════════════════ -->
            <Border Classes="card">
                <StackPanel Spacing="12">

                    <TextBlock Classes="section-title" Text="MATCH"/>
                    <Separator/>

                    <!-- Boutons START / STOP côte à côte -->
                    <Grid ColumnDefinitions="*,16,*">

                        <Button Grid.Column="0"
                                Classes="start-btn"
                                Command="{Binding StartCommand}"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Center"
                                        Spacing="4">
                                <TextBlock Text="▶" FontSize="24"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="START" FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Classes="stop-btn"
                                Command="{Binding StopCommand}"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Center"
                                        Spacing="4">
                                <TextBlock Text="⏹" FontSize="24"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="STOP" FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </Grid>

                    <!-- Bouton RESET -->
                    <Button Classes="reset-btn"
                            Command="{Binding ResetCommand}"
                            HorizontalAlignment="Stretch"
                            Content="↺  RESET"/>

                    <!-- Dernier retour -->
                    <TextBlock Text="{Binding LastCommandText}"
                               Foreground="#78909C"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>

                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════
                 SECTION STRATÉGIE
                 ═══════════════════════════════════════════════════════════ -->
            <Border Classes="card">
                <StackPanel Spacing="12">

                    <TextBlock Classes="section-title" Text="STRATÉGIE"/>
                    <Separator/>

                    <TextBlock Foreground="#78909C" FontSize="12"
                               Text="Sélectionner la stratégie active avant le match :"
                               TextWrapping="Wrap"/>

                    <!-- 3 boutons de stratégie -->
                    <!-- Surbrillance : chaque bouton contient deux couches
                         (active = cyan, inactive = gris) via IsVisible. -->
                    <Grid ColumnDefinitions="*,8,*,8,*">

                        <!-- ADAMANTINE -->
                        <Button Grid.Column="0"
                                Command="{Binding StrategyAdamantineCommand}"
                                HorizontalAlignment="Stretch"
                                MinHeight="60">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Background" Value="#1C2B3A"/>
                                    <Setter Property="BorderBrush" Value="#2A3F55"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Style>
                            </Button.Styles>
                            <!-- Couche active — visible si IsAdamantineActive -->
                            <Panel>
                                <StackPanel IsVisible="{Binding IsAdamantineActive}"
                                            HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="🛡" FontSize="18"
                                               HorizontalAlignment="Center"
                                               Foreground="#0F1923"/>
                                    <TextBlock Text="ADAMANTINE" FontSize="11"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="#0F1923"/>
                                </StackPanel>
                                <StackPanel IsVisible="{Binding !IsAdamantineActive}"
                                            HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="🛡" FontSize="18"
                                               HorizontalAlignment="Center"
                                               Foreground="#78909C"/>
                                    <TextBlock Text="ADAMANTINE" FontSize="11"
                                               HorizontalAlignment="Center"
                                               Foreground="#78909C"/>
                                </StackPanel>
                            </Panel>
                        </Button>

                        <!-- BERSERKER -->
                        <Button Grid.Column="2"
                                Command="{Binding StrategyBerserkerCommand}"
                                HorizontalAlignment="Stretch"
                                MinHeight="60">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Background" Value="#1C2B3A"/>
                                    <Setter Property="BorderBrush" Value="#2A3F55"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Style>
                            </Button.Styles>
                            <Panel>
                                <StackPanel IsVisible="{Binding IsBerserkerActive}"
                                            HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="⚡" FontSize="18"
                                               HorizontalAlignment="Center"
                                               Foreground="#0F1923"/>
                                    <TextBlock Text="BERSERKER" FontSize="11"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="#0F1923"/>
                                </StackPanel>
                                <StackPanel IsVisible="{Binding !IsBerserkerActive}"
                                            HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="⚡" FontSize="18"
                                               HorizontalAlignment="Center"
                                               Foreground="#78909C"/>
                                    <TextBlock Text="BERSERKER" FontSize="11"
                                               HorizontalAlignment="Center"
                                               Foreground="#78909C"/>
                                </StackPanel>
                            </Panel>
                        </Button>

                        <!-- CIRCLE -->
                        <Button Grid.Column="4"
                                Command="{Binding StrategyCircleCommand}"
                                HorizontalAlignment="Stretch"
                                MinHeight="60">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Background" Value="#1C2B3A"/>
                                    <Setter Property="BorderBrush" Value="#2A3F55"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Style>
                            </Button.Styles>
                            <Panel>
                                <StackPanel IsVisible="{Binding IsCircleActive}"
                                            HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="🔄" FontSize="18"
                                               HorizontalAlignment="Center"
                                               Foreground="#0F1923"/>
                                    <TextBlock Text="CIRCLE" FontSize="11"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="#0F1923"/>
                                </StackPanel>
                                <StackPanel IsVisible="{Binding !IsCircleActive}"
                                            HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="🔄" FontSize="18"
                                               HorizontalAlignment="Center"
                                               Foreground="#78909C"/>
                                    <TextBlock Text="CIRCLE" FontSize="11"
                                               HorizontalAlignment="Center"
                                               Foreground="#78909C"/>
                                </StackPanel>
                            </Panel>
                        </Button>

                    </Grid>

                    <!-- Stratégie active -->
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="#00D4FF"
                               FontSize="12"
                               Text="{Binding ActiveStrategy,
                                      StringFormat='Stratégie active : {0}',
                                      FallbackValue='Stratégie active : Aucune'}"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
