<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RobotHMI.ViewModels"
        xmlns:panels="clr-namespace:RobotHMI.Views.Panels"
        x:Class="RobotHMI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Mini-Sumo Robot HMI"
        Width="800" Height="480"
        Background="#181825">

    <!--
        MainWindow — Phase 4 (V1 complete)
        ═══════════════════════════════════
        Final DockPanel slot assignment:

          Top    → ConnectionPanel   (Phase 1, unchanged)
          Bottom → StatusBar         (Phase 4, added here)
          Left   → ControlPanel      (Phase 3, unchanged)
          Fill   → TelemetryPanel    (Phase 2, unchanged)

        Declaration order matters for DockPanel:
          1. Top-docked panels must come before Bottom-docked panels.
          2. Left/Right panels come after Top/Bottom.
          3. The fill child (no Dock attribute) must be declared last.

        "LastChildFill=True" means TelemetryPanel takes all remaining space
        after ConnectionPanel, StatusBar, and ControlPanel have claimed theirs.
    -->

    <DockPanel LastChildFill="True">

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- TOP — Connection panel (Phase 1, unchanged)                      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <panels:ConnectionPanelView
            DockPanel.Dock="Top"
            DataContext="{Binding ConnectionPanel}"
            Margin="8,8,8,4"/>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- BOTTOM — Status bar (Phase 4)                                    -->
        <!-- Must be declared before Left/Fill children so DockPanel         -->
        <!-- allocates its height before splitting the remaining width.       -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <panels:StatusBarView
            DockPanel.Dock="Bottom"
            DataContext="{Binding StatusBar}"
            Margin="8,4,8,8"/>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- LEFT — Control panel (Phase 3, unchanged)                        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <panels:ControlPanelView
            DockPanel.Dock="Left"
            DataContext="{Binding ControlPanel}"
            Margin="8,4,4,4"/>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- FILL — Telemetry panel (Phase 2, unchanged)                      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <panels:TelemetryPanelView
            DataContext="{Binding TelemetryPanel}"
            Margin="4,4,8,4"/>

    </DockPanel>

</Window>
