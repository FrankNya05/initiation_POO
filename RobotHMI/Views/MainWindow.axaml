<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RobotHMI.ViewModels"
        xmlns:panels="clr-namespace:RobotHMI.Views.Panels"
        x:Class="RobotHMI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Mini-Sumo Robot HMI"
        Width="800" Height="480"
        Background="#181825">

    <!--
        MainWindow — Phase 2
        ════════════════════
        ConnectionPanel docks to the Top (unchanged from Phase 1).
        TelemetryPanel fills the remaining space on the right.

        Phase 3 will add ControlPanel docked to the Left.
        Phase 4 will add StatusBar docked to the Bottom.

        The DockPanel layout:
          Top    → ConnectionPanel
          Fill   → TelemetryPanel (right column for now; Phase 3 splits it)
    -->

    <DockPanel LastChildFill="True">

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- TOP — Connection panel (unchanged from Phase 1)                 -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <panels:ConnectionPanelView
            DockPanel.Dock="Top"
            DataContext="{Binding ConnectionPanel}"
            Margin="8,8,8,4"/>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- FILL — Telemetry panel (added in Phase 2)                       -->
        <!-- Phase 3: this moves to the Right slot; ControlPanel takes Left. -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <panels:TelemetryPanelView
            DataContext="{Binding TelemetryPanel}"
            Margin="8,4,8,8"/>

    </DockPanel>

</Window>
