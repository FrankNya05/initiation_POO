<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RobotHMI.ViewModels"
        xmlns:panels="using:RobotHMI.Views.Panels"
        x:Class="RobotHMI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Mini-Sumo HMI"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="480"
        Background="#0F1923">

    <!-- MODIFIÉ V2 — Structure complète : barre haute + 4 onglets + barre basse -->

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ═══════════════════════════════════════════════════════════════
             BARRE SUPÉRIEURE FIXE — visible sur tous les onglets
             Hauteur ~50px, infos clés : titre, IP, connexion, batterie, état
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#1C2B3A"
                BorderBrush="#2A3F55"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <panels:StatusBarTopView/>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             NAVIGATION 4 ONGLETS
             ═══════════════════════════════════════════════════════════════ -->
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Background="#0F1923">

            <!-- ────────────────────────────────────────────────────────
                 ONGLET 1 — CONTRÔLE (par défaut)
                 ──────────────────────────────────────────────────────── -->
            <TabItem Header="⚔  CONTRÔLE">
                <panels:ControlPanelView DataContext="{Binding ControlPanel}"/>
            </TabItem>

            <!-- ────────────────────────────────────────────────────────
                 ONGLET 2 — TÉLÉMÉTRIE
                 ──────────────────────────────────────────────────────── -->
            <TabItem Header="📊  TÉLÉMÉTRIE">
                <panels:TelemetryPanelView DataContext="{Binding TelemetryPanel}"/>
            </TabItem>

            <!-- ────────────────────────────────────────────────────────
                 ONGLET 3 — MOTEURS (tests)
                 ──────────────────────────────────────────────────────── -->
            <TabItem Header="🔧  MOTEURS">
                <panels:MotorTestPanelView DataContext="{Binding MotorTestPanel}"/>
            </TabItem>

            <!-- ────────────────────────────────────────────────────────
                 ONGLET 4 — LOGS
                 ──────────────────────────────────────────────────────── -->
            <TabItem Header="📋  LOGS">
                <panels:LogPanelView DataContext="{Binding LogPanel}"/>
            </TabItem>

        </TabControl>

        <!-- ═══════════════════════════════════════════════════════════════
             BARRE INFÉRIEURE FIXE — dernier message LOG + timestamp
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="#1C2B3A"
                BorderBrush="#2A3F55"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <panels:StatusBarBottomView/>
        </Border>

    </Grid>

</Window>
