<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RobotHMI.ViewModels"
        xmlns:panels="using:RobotHMI.Views.Panels"
        x:Class="RobotHMI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Mini-Sumo HMI"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="480"
        Background="#0F1923">

    <!-- MODIFIÉ V2.1 — Ajout onglet REGLAGES (6e onglet) -->

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Barre supérieure fixe -->
        <Border Grid.Row="0" Background="#1C2B3A" BorderBrush="#2A3F55"
                BorderThickness="0,0,0,1" Padding="12,8">
            <panels:StatusBarTopView DataContext="{Binding}"/>
        </Border>

        <!-- Navigation onglets -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}"
                    Background="#0F1923">

            <TabItem Header="CONTRÔLE">
                <panels:ControlPanelView DataContext="{Binding ControlPanel}"/>
            </TabItem>

            <TabItem Header="TÉLÉMÉTRIE">
                <panels:TelemetryPanelView DataContext="{Binding TelemetryPanel}"/>
            </TabItem>

            <TabItem Header="MOTEURS">
                <panels:MotorTestPanelView DataContext="{Binding MotorTestPanel}"/>
            </TabItem>

            <TabItem Header="LOGS">
                <panels:LogPanelView DataContext="{Binding LogPanel}"/>
            </TabItem>

            <!-- NOUVEAU V2.1 -->
            <TabItem Header="REGLAGES">
                <panels:TuningPanelView DataContext="{Binding TuningPanel}"/>
            </TabItem>

            <TabItem Header="CONNEXION">
                <panels:ConnectionPanelView DataContext="{Binding ConnectionPanel}"/>
            </TabItem>

        </TabControl>

        <!-- Barre inférieure fixe -->
        <Border Grid.Row="2" Background="#1C2B3A" BorderBrush="#2A3F55"
                BorderThickness="0,1,0,0" Padding="12,6">
            <panels:StatusBarBottomView DataContext="{Binding}"/>
        </Border>

    </Grid>

</Window>
