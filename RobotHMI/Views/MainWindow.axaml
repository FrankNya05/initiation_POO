<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RobotHMI.ViewModels"
        xmlns:panels="using:RobotHMI.Views.Panels"
        x:Class="RobotHMI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Mini-Sumo HMI"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="480"
        Background="#0F1923">

    <!-- MODIFIÉ V2 — Structure : barre haute + 5 onglets + barre basse -->

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ═══════════════════════════════════════════════════════════════
             BARRE SUPÉRIEURE FIXE
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#1C2B3A"
                BorderBrush="#2A3F55"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <panels:StatusBarTopView DataContext="{Binding}"/>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             NAVIGATION 5 ONGLETS
             ═══════════════════════════════════════════════════════════════ -->
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Background="#0F1923">

            <!-- Onglet 0 — CONTRÔLE -->
            <TabItem Header="⚔  CONTRÔLE">
                <panels:ControlPanelView DataContext="{Binding ControlPanel}"/>
            </TabItem>

            <!-- Onglet 1 — TÉLÉMÉTRIE -->
            <TabItem Header="📊  TÉLÉMÉTRIE">
                <panels:TelemetryPanelView DataContext="{Binding TelemetryPanel}"/>
            </TabItem>

            <!-- Onglet 2 — MOTEURS -->
            <TabItem Header="🔧  MOTEURS">
                <panels:MotorTestPanelView DataContext="{Binding MotorTestPanel}"/>
            </TabItem>

            <!-- Onglet 3 — LOGS -->
            <TabItem Header="📋  LOGS">
                <panels:LogPanelView DataContext="{Binding LogPanel}"/>
            </TabItem>

            <!-- Onglet 4 — CONNEXION (NOUVEAU V2) -->
            <!-- Le ConnectionPanelView existant est réutilisé tel quel.
                 La barre haute reste inchangée et affiche toujours le statut. -->
            <TabItem Header="🔌  CONNEXION">
                <panels:ConnectionPanelView DataContext="{Binding ConnectionPanel}"/>
            </TabItem>

        </TabControl>

        <!-- ═══════════════════════════════════════════════════════════════
             BARRE INFÉRIEURE FIXE
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="#1C2B3A"
                BorderBrush="#2A3F55"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <panels:StatusBarBottomView DataContext="{Binding}"/>
        </Border>

    </Grid>

</Window>
